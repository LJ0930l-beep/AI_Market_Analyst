# Local persistence. Packaged Windows runs default to %LOCALAPPDATA%/AI Market Analyst.
# Leave both values unset for the packaged default; set them only for explicit
# development/test locations.
# DATABASE_PATH=data/market_analyst.sqlite3
# AIMA_DATA_ROOT=C:/Users/<user>/AppData/Local/AI Market Analyst

# Data routes: real attempts real public providers. Provider failures remain
# visible as degraded/unavailable; fixtures are never an implicit live fallback.
MARKET_DATA_MODE=real
ALLOW_FIXTURE_FALLBACK=0
MARKET_PROVIDER_TIMEOUT_SEC=10
YAHOO_CHART_BASE_URL=https://query1.finance.yahoo.com/v8/finance/chart
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://data-stream.binance.vision
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# News: real uses public Google News RSS; fixture is deterministic offline input.
NEWS_MODE=real
NEWS_PROVIDER_TIMEOUT_SEC=10
NEWS_RSS_TEMPLATE=https://news.google.com/rss/search?q={query}&hl=en-US&gl=US&ceid=US:en

# Local Bonsai model only. Requests go to llama.cpp's OpenAI-compatible API;
# legacy OLLAMA_BASE_URL / OLLAMA_MODEL overrides are ignored and reported.
LLM_MODE=bonsai
BONSAI_BASE_URL=http://127.0.0.1:8080/v1
BONSAI_MODEL_NAME=Bonsai-2-27B-PTQ1_0
BONSAI_API_KEY=not-needed-local
BONSAI_TIMEOUT_SEC=180
BONSAI_CTX=8192
OLLAMA_TIMEOUT_SEC=45
OLLAMA_MAX_TOKENS=700
OLLAMA_RETRIES=1
FAST_MODEL=Bonsai-2-27B-PTQ1_0
SMART_MODEL=Bonsai-2-27B-PTQ1_0

# Optional API runtime
API_HOST=127.0.0.1
API_PORT=8000

# V1.2 monitoring is always explicit per symbol; these limits never enable it.
MAX_MONITOR_SYMBOLS=50
MONITORING_DEFAULT_ENABLED=0
DESKTOP_AUTO_START=0
MONITORING_RESUME=0
